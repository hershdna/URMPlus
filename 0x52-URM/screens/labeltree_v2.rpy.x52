# =================
# LABEL TREE SUPPORT
# =================
# The tree is built from Ren'Py's compiled AST. This keeps it useful for
# released games, where the original .rpy sources are normally unavailable.

init -2 python in x52URM:
    import re
    import time

    class LabelTreeClass(x52NonPicklable):
        _keywords = set(['and', 'as', 'assert', 'break', 'class', 'continue',
                         'def', 'del', 'elif', 'else', 'except', 'False',
                         'finally', 'for', 'from', 'global', 'if', 'in',
                         'is', 'lambda', 'None', 'not', 'or', 'pass',
                         'raise', 'return', 'True', 'try', 'while', 'with',
                         'yield'])

        def __init__(self):
            self.labels = []
            self.nodes = []
            self.edges = []
            self.byName = {}
            self.expanded = set()
            self.selectedLabel = None
            self._signature = None
            self.xAdjustment = ui.adjustment()
            self.yAdjustment = ui.adjustment()
            self.graphWidth = 900
            self.graphHeight = 600
            self._focusToken = None
            self._lastClick = (None, 0)
            self._lastCenteredCurrent = None
            self.zoom = 1.0
            self._targetSignature = None
            self._buildRevision = 0
            self._building = False
            self._ready = False
            self._buildNames = []
            self._buildIndex = 0
            self._buildNodes = []
            self._buildEdges = []
            self._buildByName = {}
            self._buildProgress = 0
            self._nodeColumns = {}
            self._edgesByNode = {}
            self._statementLabels = {}
            # Keep an object-id map as well as the statement-name map. Ren'Py
            # uses opaque tuple names for most executable statements, and a
            # few third-party statement implementations can leave ``name``
            # unset. The live Context.current value can still be resolved by
            # looking up its AST object and using this map.
            self._statementObjectLabels = {}
            self._knownLabelNames = set()
            self._focusSignature = None
            self._pendingCenter = None
            self._currentCacheKey = None
            self._currentCacheValue = None
            self._searchCacheKey = None
            self._searchCacheResults = []
            self._searchAllResults = []
            self._searchBuildKey = None
            self._searchBuildIndex = 0
            self._searchBuildResults = []
            self._searchBuildNodes = []
            self._searchBuildRaw = ''
            self._searchBuildTerms = []
            self._searchBuildFilters = {}
            self._searchBuildShowInternal = False
            self._searchBuilding = False
            self._searchQuery = ''
            self._searchPersistentPending = False
            self._searchPersistentDue = 0
            self._viewportPersistentPending = False
            self._viewportPersistentDue = 0
            self._viewportRestorePending = True
            self._viewportLastObserved = (None, None)
            self._labelNamesCache = None
            self._branchCache = {}

        # These are persistent UI preferences, kept under a mod-specific
        # attribute instead of the game's store. The screen still mirrors the
        # values into local variables so Ren'Py updates immediately.
        _filterDefaults = {
            'filterLabels': True,
            'filterVariables': True,
            'filterConditions': True,
            'filterLinks': True,
            'filterStatements': True,
            'showInternal': False,
            'showSearchedBranches': False,
            'showCurrentBranch': True,
            'confirmBranchJump': True,
        }

        def getFilter(self, name, fallback=None):
            if fallback is None:
                fallback = self._filterDefaults.get(name, False)
            try:
                settings = getattr(renpy.game.persistent, '_x52URM_labeltree_filters', None)
                if settings is not None:
                    return bool(settings[name])
            except:
                pass
            return bool(fallback)

        def setFilter(self, name, value):
            if name not in self._filterDefaults:
                return
            try:
                oldSettings = getattr(renpy.game.persistent, '_x52URM_labeltree_filters', None)
                settings = {}
                if oldSettings is not None:
                    for key in self._filterDefaults:
                        try:
                            settings[key] = bool(oldSettings[key])
                        except:
                            pass
                settings[name] = bool(value)
                setattr(renpy.game.persistent, '_x52URM_labeltree_filters', settings)
                # Persist immediately: users should not lose their view when
                # they close/reopen the overlay or restart the game.
                renpy.save_persistent()
            except:
                # A read-only or unusual persistent backend must not make the
                # Label Tree unusable; the screen-local value still applies.
                pass

        # The game defines a Character named `max`, which shadows Python's
        # built-in max() in this dynamically loaded namespace. Keep layout
        # comparisons local so they do not depend on store globals.
        def _max2(self, left, right):
            if left > right:
                return left
            return right

        def _min2(self, left, right):
            if left < right:
                return left
            return right

        def _maxList(self, values):
            if not values:
                return 0
            result = values[0]
            for value in values[1:]:
                if value > result:
                    result = value
            return result

        def _safeText(self, value, fallback=''):
            if value is None:
                return fallback
            try:
                return unicode(value)
            except:
                try:
                    return str(value)
                except:
                    return fallback

        def _conditionText(self, value):
            text = self._safeText(value, '').strip()
            return text if text else 'else'

        def _edgeCondition(self, conditions):
            text = ' and '.join(conditions) if conditions else 'always'
            if text == 'always':
                return text
            lowered = text.lower()
            if lowered.startswith('if ') or lowered.startswith('elif ') or lowered.startswith('else '):
                return text
            return 'if ' + text

        def _nodeType(self, node):
            return type(node).__name__

        def _pythonSource(self, node):
            code = getattr(node, 'code', None)
            source = getattr(code, 'source', None)
            return self._safeText(source, '').strip()

        def _variables(self, text):
            names = []
            for name in re.findall(r'[A-Za-z_][A-Za-z0-9_.]*', text or ''):
                if name not in self._keywords and name not in names:
                    names.append(name)
            return names

        def _displayTarget(self, target, sourceLabel):
            if not target:
                return None
            target = self._safeText(target).strip()
            if target.startswith('.'):
                target = sourceLabel + target
            return target

        def _wrapLabel(self, name, width=30, maxLines=3):
            # Ren'Py text does not reliably break long underscore-separated
            # identifiers. Insert explicit line breaks while retaining the
            # complete name in the node tooltip/search data.
            name = self._safeText(name)
            if len(name) <= width:
                return name
            lines = []
            start = 0
            while start < len(name) and len(lines) < maxLines:
                end = self._min2(len(name), start + width)
                if end < len(name):
                    split = name.rfind('_', start + 1, end)
                    if split > start + (width // 2):
                        end = split + 1
                lines.append(name[start:end])
                start = end
            if start < len(name):
                lines[-1] = lines[-1][:-3] + '...'
            return '\n'.join(lines)

        def _wrapFullLabel(self, name, width=28):
            """Wrap a label for the results pane without throwing away text."""
            name = self._safeText(name)
            if len(name) <= width:
                return name
            lines = []
            start = 0
            while start < len(name):
                end = self._min2(len(name), start + width)
                if end < len(name):
                    split = name.rfind('_', start + 1, end)
                    if split > start + (width // 2):
                        end = split + 1
                lines.append(name[start:end].rstrip('_'))
                start = end
            return '\n'.join(lines)

        def previewName(self, name):
            return self._wrapFullLabel(name)

        def _nodeWidth(self, name):
            # Reserve room for the type badge and expand control. Wider cards
            # keep long labels readable while the cap prevents a single label
            # from dominating the graph.
            return self._max2(210, self._min2(420, 92 + len(name) * 7))

        def _addDetail(self, details, kind, text, node, condition=None, target=None):
            text = self._safeText(text).strip()
            if not text:
                return
            details.append({
                'kind': kind,
                'text': text,
                'condition': self._conditionText(condition) if condition is not None else None,
                'target': target,
                'line': getattr(node, 'linenumber', None),
            })

        def _scan(self, statements, sourceLabel, conditions, details, edges, depth=0):
            # Ren'Py's compiled AST is finite here: recursion follows nested
            # statement blocks, not runtime jumps. Do not truncate at an
            # arbitrary depth, or deeply nested in-label branches disappear.
            if not statements:
                return
            for node in statements:
                statementName = getattr(node, 'name', None)
                if statementName:
                    try:
                        mappedLabel = sourceLabel
                        if isinstance(statementName, basestring) and statementName in self._knownLabelNames:
                            mappedLabel = statementName
                        self._statementLabels[statementName] = mappedLabel
                    except:
                        pass
                try:
                    self._statementObjectLabels[id(node)] = sourceLabel
                except:
                    pass
                nodeType = self._nodeType(node)
                if nodeType == 'If':
                    entries = getattr(node, 'entries', []) or []
                    for index, entry in enumerate(entries):
                        condition, block = entry
                        shown = self._conditionText(condition)
                        kind = 'if' if index == 0 else ('elif' if condition else 'else')
                        self._addDetail(details, kind, shown, node, shown)
                        self._scan(block, sourceLabel, conditions + [shown], details, edges, depth + 1)
                elif nodeType == 'Menu':
                    for caption, condition, block in (getattr(node, 'items', []) or []):
                        captionText = self._safeText(caption, 'choice').strip()
                        choiceCondition = self._conditionText(condition) if condition else 'always'
                        shown = 'choice: %s' % captionText
                        if choiceCondition != 'always':
                            shown += ' [%s]' % choiceCondition
                        self._addDetail(details, 'menu', shown, node, choiceCondition)
                        self._scan(block, sourceLabel, conditions + [shown], details, edges, depth + 1)
                elif nodeType == 'While':
                    condition = self._conditionText(getattr(node, 'condition', None))
                    self._addDetail(details, 'while', condition, node, condition)
                    self._scan(getattr(node, 'block', None), sourceLabel, conditions + [condition], details, edges, depth + 1)
                elif nodeType == 'Python':
                    source = self._pythonSource(node)
                    if source:
                        oneLine = ' '.join(source.split())
                        if len(oneLine) > 180:
                            oneLine = oneLine[:177] + '...'
                        self._addDetail(details, 'variable', oneLine, node)
                elif nodeType == 'Jump' or nodeType == 'Call':
                    target = None if getattr(node, 'expression', None) else self._displayTarget(getattr(node, 'target', None) if nodeType == 'Jump' else getattr(node, 'label', None), sourceLabel)
                    verb = 'jump' if nodeType == 'Jump' else 'call'
                    shown = verb + ' ' + (target or 'expression')
                    self._addDetail(details, 'link', shown, node, ' and '.join(conditions) if conditions else 'always', target)
                    # The complete label index was obtained from Ren'Py before
                    # the background build started. Use it as the edge source
                    # of truth rather than calling has_label for every link;
                    # this also keeps dynamically loaded/overridden labels in
                    # the same graph as the labels returned by get_all_labels.
                    if target and target in self._knownLabelNames:
                        edges.append({
                            'source': sourceLabel,
                            'target': target,
                            'condition': self._edgeCondition(conditions),
                            'kind': verb,
                        })
                elif nodeType == 'Label':
                    self._scan(getattr(node, 'block', None), sourceLabel, conditions, details, edges, depth + 1)

        def _fallthroughLabel(self, label):
            """Find the next top-level label in Ren'Py's compiled chain.

            Ren'Py chains the final statement in a label block to the next
            top-level statement. Explicit jumps/calls are not the only flow:
            a label can fall through into the next label when its block ends.
            Include that edge so a full branch matches actual script flow.
            """
            block = getattr(label, 'block', None) or []
            cursor = getattr(block[-1], 'next', None) if block else getattr(label, 'next', None)
            seen = set()
            steps = 0
            while cursor is not None and steps < 512:
                nodeType = self._nodeType(cursor)
                name = getattr(cursor, 'name', None)
                if nodeType == 'Label' and name in self._knownLabelNames:
                    return name
                try:
                    marker = id(cursor)
                    if marker in seen:
                        return None
                    seen.add(marker)
                except:
                    pass
                cursor = getattr(cursor, 'next', None)
                steps += 1
            return None

        def _labelNames(self):
            if self._labelNamesCache is not None:
                return self._labelNamesCache
            try:
                names = list(renpy.get_all_labels())
            except:
                names = []
            self._labelNamesCache = sorted(set([self._safeText(name) for name in names]), key=lambda name: name.lower())
            return self._labelNamesCache

        def _beginBuild(self, names, force=False):
            signature = tuple(names)
            if not force and self._targetSignature == signature and self._building:
                return
            if not force and self._ready and self._signature == signature:
                return
            self._targetSignature = signature
            self._building = True
            self._ready = False
            self._buildNames = names
            self._knownLabelNames = set(names)
            self._buildIndex = 0
            self._buildNodes = []
            self._buildEdges = []
            self._buildByName = {}
            self._buildProgress = 0
            self._nodeColumns = {}
            self._edgesByNode = {}
            self._statementLabels = {}
            self._statementObjectLabels = {}
            self._focusSignature = None
            self._pendingCenter = None
            self._currentCacheKey = None
            self._currentCacheValue = None
            self._searchCacheKey = None
            self._searchCacheResults = []
            self._searchAllResults = []
            self._searchBuildKey = None
            self._searchBuildIndex = 0
            self._searchBuildResults = []
            self._searchBuildNodes = []
            self._searchBuilding = False
            self._branchCache = {}
            self._pendingJumpTarget = None
            self._pendingJumpVariables = []
            self._pendingJumpValues = {}
            self._pendingJumpOriginalValues = {}
            self.labels = names
            self.nodes = []
            self.edges = []
            self.byName = {}
            self.graphWidth = 900
            self.graphHeight = 540

        def _stepBuild(self, budget=8):
            if not self._building:
                return
            endIndex = self._min2(len(self._buildNames), self._buildIndex + budget)
            while self._buildIndex < endIndex:
                name = self._buildNames[self._buildIndex]
                details = []
                edges = []
                try:
                    label = renpy.game.script.lookup(name)
                    self._statementLabels[name] = name
                    self._scan(getattr(label, 'block', None), name, [], details, edges)
                    nextLabel = self._fallthroughLabel(label)
                    if nextLabel and nextLabel != name:
                        edges.append({
                            'source': name,
                            'target': nextLabel,
                            'condition': 'always',
                            'kind': 'flow',
                        })
                except:
                    pass
                deduped = []
                seenDetails = set()
                for detail in details:
                    key = (detail['kind'], detail['text'], detail.get('condition'), detail.get('target'))
                    if key not in seenDetails:
                        seenDetails.add(key)
                        deduped.append(detail)
                node = {
                    'name': name,
                    'displayName': self._wrapLabel(name),
                    'details': deduped,
                    'internal': name.startswith('_'),
                    'kind': 'Internal' if name.startswith('_') else 'Label',
                }
                node['_searchFields'] = self._makeSearchFields(node)
                self._buildNodes.append(node)
                self._buildByName[name] = node
                self._buildEdges.extend(edges)
                self._buildIndex += 1
            if self._buildNames:
                self._buildProgress = int((self._buildIndex * 100) / len(self._buildNames))
            else:
                self._buildProgress = 100
            if self._buildIndex < len(self._buildNames):
                return

            uniqueEdges = []
            seenEdges = set()
            for edge in self._buildEdges:
                key = (edge['source'], edge['target'], edge['condition'], edge['kind'])
                if key not in seenEdges:
                    seenEdges.add(key)
                    uniqueEdges.append(edge)
            self.nodes = self._buildNodes
            self.byName = self._buildByName
            self.edges = uniqueEdges
            self._layout()
            self._edgesByNode = {}
            for edge in self.edges:
                self._edgesByNode.setdefault(edge['source'], []).append(edge)
                self._edgesByNode.setdefault(edge['target'], []).append(edge)
            self._searchCacheKey = None
            self._searchCacheResults = []
            self._searchAllResults = []
            self._signature = self._targetSignature
            self._buildRevision += 1
            self._building = False
            self._ready = True
            self._buildProgress = 100

        def ensureBuilt(self, budget=4):
            names = self._labelNames()
            signature = tuple(names)
            if self._ready and self._signature == signature:
                return
            if self._targetSignature != signature or not self._building:
                self._beginBuild(names)
            self._stepBuild(budget)

        def buildTick(self, budget=8):
            # Continue incrementally from a timer. Restarting directly from
            # screen Python can create a tight loop that starves input/rendering
            # on large games.
            if self._building:
                self._stepBuild(budget)
                renpy.restart_interaction()

        def savedSearchQuery(self):
            """Return the last Label Tree query without touching game globals."""
            try:
                return self._safeText(getattr(renpy.game.persistent,
                                              '_x52URM_labeltree_query', ''), '')
            except:
                return ''

        def setSearchQuery(self, query):
            """Keep the query alive across URM screen hide/show cycles.

            The persistent object is updated immediately so reopening URM in
            the same session never loses the text. Disk persistence is
            debounced and performed by the background tick, avoiding a costly
            save-persistent call for every keystroke.
            """
            value = self._safeText(query, '')
            if value == self._searchQuery:
                return
            self._searchQuery = value
            try:
                setattr(renpy.game.persistent, '_x52URM_labeltree_query', value)
                self._schedulePersistentSave()
            except:
                pass

        def _schedulePersistentSave(self):
            self._searchPersistentPending = True
            self._searchPersistentDue = time.time() + .35

        def _safeOffset(self, value):
            try:
                value = float(value)
                return 0.0 if value < 0 else value
            except:
                return 0.0

        def _savedViewportState(self):
            try:
                state = getattr(renpy.game.persistent,
                                '_x52URM_labeltree_viewport', None)
                if isinstance(state, dict):
                    return (self._safeOffset(state.get('x', 0)),
                            self._safeOffset(state.get('y', 0)))
            except:
                pass
            return (0.0, 0.0)

        def noteViewportPosition(self):
            """Queue the current graph offsets with the search preferences.

            Viewport adjustments are updated by Ren'Py during interaction,
            including mouse-wheel and draggable scrolling. Sampling them once
            per screen interaction avoids depending on private Adjustment
            callbacks that differ between Ren'Py releases.
            """
            if self._viewportRestorePending:
                return
            x = self._safeOffset(getattr(self.xAdjustment, 'value', 0))
            y = self._safeOffset(getattr(self.yAdjustment, 'value', 0))
            observed = (x, y)
            if observed == self._viewportLastObserved:
                return
            self._viewportLastObserved = observed
            try:
                setattr(renpy.game.persistent,
                        '_x52URM_labeltree_viewport', {'x': x, 'y': y})
                self._viewportPersistentPending = True
                self._viewportPersistentDue = time.time() + .35
            except:
                pass

        def _applySavedViewportPosition(self):
            if not self._viewportRestorePending:
                return False
            x, y = self._savedViewportState()
            try:
                self.xAdjustment.value = x
                self.yAdjustment.value = y
            except:
                return False
            self._viewportRestorePending = False
            self._viewportLastObserved = (x, y)
            return True

        def flushSearchPersistence(self):
            self.noteViewportPosition()
            if (not self._searchPersistentPending and
                    not self._viewportPersistentPending):
                return
            try:
                renpy.save_persistent()
            except:
                return
            self._searchPersistentPending = False
            self._viewportPersistentPending = False

        def _searchTerms(self, query):
            raw = self._safeText(query, '').strip().lower()
            terms = []
            # Treat spaces, underscores, and punctuation as token separators.
            # Thus "nurse quest" matches nurse_quest, quest_nurse, and
            # nurse_02_quest when both tokens are present in an enabled field.
            for token in re.findall(r'[A-Za-z0-9]+', raw):
                if token not in terms:
                    terms.append(token)
            if raw and not terms:
                terms = [raw]
            return raw, terms

        def _searchMatchesTerms(self, node, terms, filters, showInternal):
            if node['internal'] and not showInternal:
                return False
            if not terms:
                return True
            fields = node.get('_searchFields') or self._makeSearchFields(node)
            values = []
            for key in ('labels', 'variables', 'conditions', 'links', 'statements'):
                if filters.get(key):
                    values.append(fields.get(key, ''))
            haystack = ' '.join(values)
            for token in terms:
                if token not in haystack:
                    return False
            return True

        def _searchScore(self, node, raw, terms, filters):
            fields = node.get('_searchFields') or self._makeSearchFields(node)
            labelText = fields.get('labels', '')
            score = 0
            if raw and raw in labelText:
                score += 100
            for token in terms:
                if token in labelText:
                    score += 30
                else:
                    for key in ('variables', 'conditions', 'links', 'statements'):
                        if filters.get(key) and token in fields.get(key, ''):
                            score += 10
                            break
            return score

        def _sortSearchResults(self, results, raw, terms, filters):
            ranked = []
            for position, node in enumerate(results):
                ranked.append((-self._searchScore(node, raw, terms, filters),
                               node['name'].lower(), position, node))
            ranked.sort(key=lambda item: (item[0], item[1], item[2]))
            return [item[3] for item in ranked]

        def _startSearchBuild(self, cacheKey, raw, terms, filters,
                              showInternal):
            self._searchBuildKey = cacheKey
            self._searchBuildIndex = 0
            self._searchBuildResults = []
            self._searchBuildNodes = self._searchCandidateNodes()
            self._searchBuildRaw = raw
            self._searchBuildTerms = terms
            self._searchBuildFilters = filters
            self._searchBuildShowInternal = showInternal
            self._searchBuilding = True
            self._searchAllResults = []
            self._searchCacheResults = []

        def _stepSearchBuild(self, budget=64):
            if not self._searchBuilding:
                return False
            endIndex = self._min2(len(self._searchBuildNodes),
                                  self._searchBuildIndex + budget)
            while self._searchBuildIndex < endIndex:
                node = self._searchBuildNodes[self._searchBuildIndex]
                if self._searchMatchesTerms(node, self._searchBuildTerms,
                                             self._searchBuildFilters,
                                             self._searchBuildShowInternal):
                    self._searchBuildResults.append(node)
                self._searchBuildIndex += 1
            self._searchAllResults = self._sortSearchResults(
                self._searchBuildResults, self._searchBuildRaw,
                self._searchBuildTerms, self._searchBuildFilters)
            self._searchCacheResults = self._searchAllResults[:12]
            if self._searchBuildIndex >= len(self._searchBuildNodes):
                self._searchBuilding = False
                self._searchCacheKey = self._searchBuildKey
            return True

        def isSearchBuilding(self):
            return self._searchBuilding

        def needsBackgroundTick(self):
            return (self._building or self._searchBuilding or
                    self._searchPersistentPending or
                    self._viewportPersistentPending or
                    self._viewportRestorePending)

        def backgroundTick(self, buildBudget=8, searchBudget=64):
            changed = False
            if self._viewportRestorePending:
                changed = self._applySavedViewportPosition() or changed
            self.noteViewportPosition()
            if self._building:
                self._stepBuild(buildBudget)
                changed = True
            if self._searchBuilding:
                changed = self._stepSearchBuild(searchBudget) or changed
            if self._searchPersistentPending and time.time() >= self._searchPersistentDue:
                self.flushSearchPersistence()
            if changed:
                renpy.restart_interaction()

        def isBuilding(self):
            return self._building

        def buildProgress(self):
            return self._buildProgress

        def refresh(self):
            self._labelNamesCache = None
            self._beginBuild(self._labelNames(), force=True)
            renpy.restart_interaction()

        def _layout(self):
            names = [node['name'] for node in self.nodes]
            levels = dict((name, 0) for name in names)
            for unused in range(self._min2(12, len(names))):
                changed = False
                for edge in self.edges:
                    if edge['source'] in levels and edge['target'] in levels:
                        newLevel = levels[edge['source']] + 1
                        if newLevel > levels[edge['target']]:
                            levels[edge['target']] = newLevel
                            changed = True
                if not changed:
                    break
            groups = {}
            for node in self.nodes:
                groups.setdefault(levels.get(node['name'], 0), []).append(node)
            # Lay the graph out vertically. The previous horizontal-column
            # layout anchored level zero at the left edge, which made every
            # connector run across the viewport and obscured the flow.
            levelGap = 64
            siblingGap = 32
            siblingRowGap = 26
            nodeHeight = 82
            maxLevelWidth = 1400
            levelRows = {}
            levelHeights = {}
            # Keep a small navigation margin even when the focused path is
            # shorter than the window. This gives Ren'Py's viewport a real
            # scrollable child while keeping the focused nodes centered.
            graphWidth = self._max2(1000, renpy.config.screen_width)
            for level, group in groups.items():
                group.sort(key=lambda node: node['name'].lower())
                rows = []
                currentRow = []
                currentWidth = 0
                for node in group:
                    node['width'] = self._nodeWidth(node['name'])
                    node['height'] = nodeHeight
                    neededWidth = node['width'] if not currentRow else currentWidth + siblingGap + node['width']
                    if currentRow and neededWidth > maxLevelWidth:
                        rows.append(currentRow)
                        currentRow = []
                        currentWidth = 0
                    currentRow.append(node)
                    currentWidth = node['width'] if len(currentRow) == 1 else currentWidth + siblingGap + node['width']
                if currentRow:
                    rows.append(currentRow)
                levelRows[level] = rows
                levelHeight = len(rows) * nodeHeight + self._max2(0, len(rows) - 1) * siblingRowGap
                levelHeights[level] = levelHeight
                levelMaxWidth = 0
                for row in rows:
                    rowWidth = 0
                    for index, node in enumerate(row):
                        rowWidth += node['width']
                        if index:
                            rowWidth += siblingGap
                    if rowWidth > levelMaxWidth:
                        levelMaxWidth = rowWidth
                if levelMaxWidth + 60 > graphWidth:
                    graphWidth = levelMaxWidth + 60
            graphWidth = self._max2(1000, self._min2(maxLevelWidth + 60, graphWidth))
            sortedLevels = sorted(groups.keys())
            currentY = 30
            for level in sortedLevels:
                for rowIndex, row in enumerate(levelRows[level]):
                    totalWidth = 0
                    for index, node in enumerate(row):
                        totalWidth += node['width']
                        if index:
                            totalWidth += siblingGap
                    startX = (graphWidth - totalWidth) / 2
                    currentX = startX
                    for node in row:
                        node['_column'] = level
                        node['x'] = currentX
                        node['y'] = currentY + rowIndex * (nodeHeight + siblingRowGap)
                        currentX += node['width'] + siblingGap
                currentY += levelHeights[level] + levelGap
            self._layoutRowHeight = nodeHeight + siblingRowGap
            self.graphWidth = graphWidth
            self.graphHeight = self._max2(self._max2(540, currentY - levelGap + 30), renpy.config.screen_height)
            self._nodeColumns = groups
            self._focusSignature = None

        def _branchNames(self, anchor):
            """Return the complete start-to-finish flow containing anchor.

            A view-filter branch is not a one-level neighborhood. First walk
            backwards through every incoming flow edge to find the entry
            points. Then walk forwards from those entries through every
            outgoing edge, retaining every conditional branch, join,
            fall-through label, and terminal path. Cycles are guarded by the
            visited sets. This is cached per anchor: changing a checkbox or
            redrawing the viewport does not walk the graph again.
            """
            if anchor in self._branchCache:
                return self._branchCache[anchor]

            # Phase 1: collect the complete upstream path and its roots.
            upstream = set([anchor])
            pending = [anchor]
            while pending:
                label = pending.pop()
                for edge in self._edgesByNode.get(label, []):
                    if edge['target'] != label:
                        continue
                    parent = edge['source']
                    if parent in self.byName and parent not in upstream:
                        upstream.add(parent)
                        pending.append(parent)

            roots = []
            for label in upstream:
                hasParent = False
                for edge in self._edgesByNode.get(label, []):
                    if edge['target'] == label and edge['source'] in upstream and edge['source'] != label:
                        hasParent = True
                        break
                if not hasParent:
                    roots.append(label)
            if not roots:
                # A wholly cyclic flow has no graph-theoretic root. The
                # selected/current label is the deterministic entry point.
                roots = [anchor]

            # Phase 2: retain every downstream branch from every entry point.
            branch = set(upstream)
            forwardVisited = set()
            pending = roots[:]
            while pending:
                label = pending.pop()
                if label in forwardVisited:
                    continue
                forwardVisited.add(label)
                for edge in self._edgesByNode.get(label, []):
                    if edge['source'] != label:
                        continue
                    child = edge['target']
                    if child in self.byName:
                        branch.add(child)
                        if child not in forwardVisited:
                            pending.append(child)

            # If a cyclic edge bypasses the root walk, still include all flow
            # reachable from the anchor itself.
            pending = [anchor]
            while pending:
                label = pending.pop()
                if label in forwardVisited:
                    continue
                forwardVisited.add(label)
                for edge in self._edgesByNode.get(label, []):
                    if edge['source'] != label:
                        continue
                    child = edge['target']
                    if child in self.byName:
                        branch.add(child)
                        if child not in forwardVisited:
                            pending.append(child)

            self._branchCache[anchor] = branch
            return branch

        def _focusedNames(self, query='', labels=True, variables=True, conditions=True, links=True, statements=True, showInternal=False, showSearched=True, showCurrent=True):
            """Return complete flows selected by the active view filters.

            Search navigation chooses one searched result as the active search
            anchor, while Current chooses the active in-game label. Each
            enabled anchor contributes its full start-to-finish label flow
            rather than only the anchor and one adjacent node. The searched
            branch is the flow containing the active search result (the
            selected result, or the first result until Previous/Next selects
            another).
            """
            anchors = []
            results = self._allSearchResults(query, labels, variables, conditions, links, statements, showInternal) if query else []
            selected = self.selectedLabel if self.selectedLabel in self.byName else None
            current = self.currentLabel()
            if showSearched and query and results:
                if selected:
                    anchors.append(selected)
                else:
                    anchors.append(results[0]['name'])
            if showCurrent and current in self.byName and current != 'after_load' and current not in anchors:
                anchors.append(current)
            if not anchors:
                return set()

            focused = set()
            for anchor in anchors:
                focused.update(self._branchNames(anchor))
            return focused

        def _layoutFocus(self, focusedNames):
            """Compactly lay out the currently visible subgraph."""
            signature = tuple(sorted(focusedNames))
            if signature == self._focusSignature:
                return
            self._focusSignature = signature
            if not focusedNames:
                self.graphWidth = self._max2(1000, renpy.config.screen_width)
                self.graphHeight = self._max2(540, renpy.config.screen_height)
                return
            groups = {}
            for name in focusedNames:
                node = self.byName.get(name)
                if node:
                    groups.setdefault(node.get('_column', 0), []).append(node)
            levelGap = 112
            siblingGap = 64
            siblingRowGap = 42
            nodeHeight = 86
            maxLevelWidth = 960
            graphWidth = self._max2(1000, renpy.config.screen_width)
            currentY = 30
            for level in sorted(groups.keys()):
                group = groups[level]
                group.sort(key=lambda node: node['name'].lower())
                rows = []
                currentRow = []
                currentWidth = 0
                for node in group:
                    node['width'] = self._nodeWidth(node['name'])
                    node['height'] = nodeHeight
                    neededWidth = node['width'] if not currentRow else currentWidth + siblingGap + node['width']
                    if currentRow and neededWidth > maxLevelWidth:
                        rows.append(currentRow)
                        currentRow = []
                        currentWidth = 0
                    currentRow.append(node)
                    currentWidth = node['width'] if len(currentRow) == 1 else currentWidth + siblingGap + node['width']
                if currentRow:
                    rows.append(currentRow)
                levelMaxWidth = 0
                for rowIndex, row in enumerate(rows):
                    rowWidth = 0
                    for index, node in enumerate(row):
                        rowWidth += node['width']
                        if index:
                            rowWidth += siblingGap
                    levelMaxWidth = self._max2(levelMaxWidth, rowWidth)
                    startX = (graphWidth - rowWidth) / 2
                    currentX = startX
                    for node in row:
                        node['x'] = currentX
                        node['y'] = currentY + rowIndex * (nodeHeight + siblingRowGap)
                        currentX += node['width'] + siblingGap
                graphWidth = self._max2(graphWidth, self._min2(maxLevelWidth + 60, 1080))
                currentY += len(rows) * nodeHeight + self._max2(0, len(rows) - 1) * siblingRowGap + levelGap
            self.graphWidth = graphWidth
            self.graphHeight = self._max2(self._max2(540, currentY - levelGap + 30), renpy.config.screen_height)

        def _applyPendingCenter(self):
            if self._pendingCenter in self.byName:
                name = self._pendingCenter
                self._pendingCenter = None
                self.center(name)

        def _selectedPathNames(self):
            target = self.selectedLabel if self.selectedLabel in self.byName else self.currentLabel()
            if target not in self.byName:
                return set()
            path = set([target])
            pending = [target]
            while pending:
                child = pending.pop()
                for edge in self._edgesByNode.get(child, []):
                    if edge['target'] != child:
                        continue
                    parent = edge['source']
                    if parent in self.byName and parent not in path:
                        path.add(parent)
                        pending.append(parent)
            return path

        def isSelectedPathEdge(self, edge):
            path = self._selectedPathNames()
            return edge['source'] in path and edge['target'] in path

        def currentLabel(self):
            # Ren'Py's context points at the active statement, not necessarily
            # at a label. The build records each statement's containing label,
            # so this remains accurate while dialogue is running.
            currentStatement = None
            callbackLabel = None
            try:
                # Ren'Py 7.4's public renpy.context() returns the saveable
                # context-info object; it does not expose the executing AST
                # statement. The live execution Context is the object used
                # by the engine for Context.current (see execution.py).
                currentStatement = getattr(renpy.game.context(), 'current', None)
            except:
                currentStatement = None
            try:
                callbackLabel = LabelMon.lastLabel
            except:
                pass
            try:
                logLength = len(getattr(renpy.game.log, 'log', []) or [])
            except:
                logLength = 0
            cacheKey = (currentStatement, callbackLabel, logLength, self._ready)
            if cacheKey == self._currentCacheKey:
                return self._currentCacheValue
            candidates = [currentStatement]
            try:
                rollbackLog = getattr(renpy.game.log, 'log', []) or []
                inspected = 0
                for rollback in reversed(rollbackLog):
                    rollbackContext = getattr(rollback, 'context', None)
                    if rollbackContext is not None:
                        candidates.append(getattr(rollbackContext, 'current', None))
                    inspected += 1
                    if inspected >= 64:
                        break
            except:
                pass
            # LabelMon is the original mod's callback-based fallback. Ignore
            # Ren'Py's menu/load helper labels, which are not game locations.
            candidates.append(callbackLabel)
            helperLabels = set(['after_load', 'before_load', '_after_load',
                                'save_screen', 'load_screen', '_save_screen',
                                '_load_screen', '_noisy_return'])
            for candidate in candidates:
                if candidate in helperLabels:
                    continue
                mapped = self._statementLabels.get(candidate, None)
                if mapped is None:
                    try:
                        statementNode = renpy.game.script.lookup(candidate)
                        mapped = self._statementObjectLabels.get(id(statementNode), None)
                        if mapped is None and self._nodeType(statementNode) == 'Label':
                            mapped = getattr(statementNode, 'name', None)
                    except:
                        mapped = None
                if mapped is None and isinstance(candidate, basestring):
                    mapped = candidate
                if mapped in self.byName and mapped not in helperLabels:
                    self._currentCacheKey = cacheKey
                    self._currentCacheValue = mapped
                    return mapped
            self._currentCacheKey = cacheKey
            self._currentCacheValue = None
            return None

        def highlightedLabel(self):
            current = self.currentLabel()
            if self.selectedLabel in self.byName:
                return self.selectedLabel
            return current

        def toggleExpanded(self, name):
            if name in self.expanded:
                self.expanded.remove(name)
            else:
                self.expanded.add(name)

        def focus(self, name):
            if name in self.byName:
                self.selectedLabel = name
                self._focusToken = (name, renpy.random.random())
                self._pendingCenter = name
                renpy.restart_interaction()

        def center(self, name):
            node = self.byName.get(name)
            if not node:
                return
            nodeCenterX = node.get('x', 0) + node.get('width', 0) / 2
            nodeCenterY = node.get('y', 0) + node.get('height', 0) / 2
            self.xAdjustment.value = self._max2(0, nodeCenterX * self.zoom - 420)
            self.yAdjustment.value = self._max2(0, nodeCenterY * self.zoom - 220)

        def centerSelected(self):
            name = self.selectedLabel or self.currentLabel()
            if name in self.byName:
                self._pendingCenter = name
                self._focusToken = (name, renpy.random.random())
                renpy.restart_interaction()

        def centerCurrentNow(self):
            current = self.currentLabel()
            if current in self.byName:
                self._pendingCenter = current
                renpy.restart_interaction()

        def centerCurrent(self):
            if not self._ready:
                return
            current = self.currentLabel()
            if current and current != self._lastCenteredCurrent:
                self._lastCenteredCurrent = current
                if not self.selectedLabel:
                    self._pendingCenter = current

        def nodeClicked(self, name):
            now = time.time()
            previousName, previousTime = self._lastClick
            self.selectedLabel = name
            self._lastClick = (name, now)
            # Ren'Py buttons report each mouse activation separately; keep the
            # first click as selection and treat a second activation of the
            # same node within a forgiving native double-click interval as a
            # jump. Returning a value also ends the screen interaction cleanly.
            if previousName == name and now - previousTime < .65:
                self._lastClick = (None, 0)
                self.prepareJump(name)
                return True
            else:
                renpy.restart_interaction()

        def zoomIn(self):
            self.zoom = self._min2(2.0, round(self.zoom + .1, 2))
            renpy.restart_interaction()

        def zoomOut(self):
            self.zoom = self._max2(.5, round(self.zoom - .1, 2))
            renpy.restart_interaction()

        def zoomReset(self):
            self.zoom = 1.0
            renpy.restart_interaction()

        def zoomPercentText(self):
            return '%d%%' % (self.zoom * 100)

        def clearFocus(self):
            self.selectedLabel = None
            self._lastCenteredCurrent = None
            self._pendingCenter = self.currentLabel()
            renpy.restart_interaction()

        def _conditionalVariableName(self, name):
            ignored = set(['and', 'or', 'not', 'True', 'False', 'None', 'always',
                           'renpy', 'store', 'persistent', 'game', 'config',
                           'getattr', 'hasattr', 'isinstance', 'len', 'str',
                           'int', 'float', 'bool', 'list', 'dict', 'set'])
            if not name or name in ignored or name.startswith('_'):
                return False
            return name[0].isalpha() or name[0] == '_'

        def _conditionalValues(self, text, variables):
            text = self._safeText(text, '').strip()
            if not text:
                return
            # Capture values from the common Ren'Py/Python conditional forms.
            comparison = r'([A-Za-z_][A-Za-z0-9_.]*)\s*(?:==|!=|<=|>=|<|>)\s*([^\s\)\]\},&|]+)'
            for match in re.findall(comparison, text):
                name, value = match
                if self._conditionalVariableName(name):
                    variables.setdefault(name, [])
                    value = value.strip().rstrip(':')
                    if value and value not in variables[name]:
                        variables[name].append(value)
            membership = r'([A-Za-z_][A-Za-z0-9_.]*)\s+in\s*[\(\[]([^\)\]]*)[\)\]]'
            for match in re.findall(membership, text):
                name, values = match
                if self._conditionalVariableName(name):
                    variables.setdefault(name, [])
                    for value in values.split(','):
                        value = value.strip()
                        if value and value not in variables[name]:
                            variables[name].append(value)
            for name in self._variables(text):
                if self._conditionalVariableName(name):
                    variables.setdefault(name, [])

        def _jumpVariableValue(self, name):
            """Resolve a candidate without invoking game code."""
            try:
                if name.startswith('persistent.'):
                    owner = renpy.game.persistent
                    path = name[11:]
                elif name.startswith('store.'):
                    owner = renpy.store
                    path = name[6:]
                else:
                    owner = renpy.store
                    path = name
                if not path:
                    return False, None
                for part in path.split('.'):
                    if not hasattr(owner, part):
                        return False, None
                    owner = getattr(owner, part)
                return True, owner
            except:
                return False, None

        def _isJumpScalar(self, value):
            # Never overwrite game objects, containers, Characters, or custom
            # engine state. The confirmation UI is allowed to edit only
            # scalar values that the game's conditional logic can safely read.
            try:
                return isinstance(value, (bool, int, long, float, basestring)) or value is None
            except:
                return isinstance(value, (bool, int, float, basestring)) or value is None

        def _isSafeJumpVariableName(self, name):
            """Allow confirmation writes only to simple store variables.

            A Ren'Py conditional can mention arbitrary game-engine paths such
            as ``quest.nurse_roped``.  Even when the current value happens to
            be a scalar, assigning to an object attribute can violate that
            game's invariants and break later script code.  Label Tree is a
            cross-game tool, so only plain store/persistent roots are safe to
            edit generically.  Nested paths remain searchable, but are never
            written by the confirmation dialog.
            """
            name = self._safeText(name, '').strip()
            if not name:
                return False
            if name.startswith('persistent.'):
                path = name[11:]
            elif name.startswith('store.'):
                path = name[6:]
            else:
                path = name
            return re.match(r'^[A-Za-z_][A-Za-z0-9_]*$', path) is not None

        def _branchJumpVariables(self, target):
            variables = {}
            branchNames = self._branchNames(target)
            for edge in self.edges:
                if edge['source'] in branchNames and edge['target'] in branchNames:
                    self._conditionalValues(edge.get('condition'), variables)
            for name in branchNames:
                node = self.byName.get(name)
                if not node:
                    continue
                for detail in node.get('details', []):
                    if detail.get('kind') in ('if', 'elif', 'else', 'while', 'menu'):
                        self._conditionalValues(detail.get('condition') or detail.get('text'), variables)
            result = []
            for name in sorted(variables.keys(), key=lambda value: value.lower()):
                if not self._isSafeJumpVariableName(name):
                    continue
                exists, currentValue = self._jumpVariableValue(name)
                if not exists or not self._isJumpScalar(currentValue):
                    continue
                options = list(variables[name])
                if not options:
                    if isinstance(currentValue, bool):
                        options = ['True', 'False']
                    elif currentValue is not None:
                        options = [self._safeText(currentValue)]
                    else:
                        continue
                # Keep the live value as the initial selection. The first
                # observed branch option is not necessarily the current game
                # state, and Done must not silently rewrite it.
                currentText = self._safeText(currentValue)
                if currentText not in options:
                    options.insert(0, currentText)
                result.append({'name': name, 'options': options,
                               'value': currentText,
                               'originalValue': currentValue})
            return result

        def _executeJump(self, name):
            # Keep the actual jump on the Ren'Py side of the boundary. This
            # helper is also used when confirmation is disabled or when a
            # branch contains no detected variables.
            renpy.hide_screen('URM_main')
            renpy.jump(name)

        def prepareJump(self, name):
            if not self.getFilter('confirmBranchJump', True):
                return self._executeJump(name)
            variables = self._branchJumpVariables(name)
            self._pendingJumpTarget = name
            self._pendingJumpVariables = variables
            self._pendingJumpValues = dict((item['name'], item['value']) for item in variables)
            self._pendingJumpOriginalValues = dict((item['name'], item.get('originalValue')) for item in variables)
            renpy.show_screen('URM_labeltree_jump_confirm', _layer='x52Overlay')
            renpy.restart_interaction()

        def pendingJumpVariables(self):
            return self._pendingJumpVariables

        def pendingJumpValue(self, name):
            return self._pendingJumpValues.get(name, '')

        def setPendingJumpValue(self, name, value):
            if name in self._pendingJumpValues:
                self._pendingJumpValues[name] = value
            try:
                renpy.restart_interaction()
            except:
                pass

        def cancelPendingJump(self):
            self._pendingJumpTarget = None
            self._pendingJumpVariables = []
            self._pendingJumpValues = {}
            self._pendingJumpOriginalValues = {}
            renpy.hide_screen('URM_labeltree_jump_confirm')
            renpy.hide_screen('URM_labeltree_jump_value_menu')
            renpy.restart_interaction()

        def _jumpValue(self, value):
            value = self._safeText(value, '').strip()
            try:
                return renpy.python.py_eval(value)
            except:
                return value

        def _jumpTypesCompatible(self, expected, actual):
            """Prevent a dropdown from changing a game's variable type."""
            try:
                if isinstance(expected, bool):
                    return isinstance(actual, bool)
                if isinstance(expected, (int, long)):
                    return isinstance(actual, (int, long)) and not isinstance(actual, bool)
                if isinstance(expected, float):
                    return isinstance(actual, (int, long, float)) and not isinstance(actual, bool)
                if isinstance(expected, basestring):
                    return isinstance(actual, basestring)
            except:
                if isinstance(expected, bool):
                    return isinstance(actual, bool)
                if isinstance(expected, int):
                    return isinstance(actual, int) and not isinstance(actual, bool)
                if isinstance(expected, float):
                    return isinstance(actual, (int, float)) and not isinstance(actual, bool)
                if isinstance(expected, str):
                    return isinstance(actual, str)
            return expected is None and actual is None

        def _setJumpVariable(self, name, value, originalValue=None):
            # Do not assign through arbitrary object attributes.  This is a
            # final defensive check in case a caller supplies a variable
            # outside the normal confirmation-collection path.
            if not self._isSafeJumpVariableName(name):
                return
            exists, currentValue = self._jumpVariableValue(name)
            if not exists or not self._isJumpScalar(currentValue):
                return
            # Do not overwrite a value that changed while the confirmation
            # dialog was open. The scene owns its state; Label Tree should not
            # race it during a long-running interaction.
            if originalValue is not None and currentValue != originalValue:
                return
            value = self._jumpValue(value)
            if not self._isJumpScalar(value):
                return
            if not self._jumpTypesCompatible(currentValue, value):
                return
            # Confirming without changing a dropdown must be a no-op for game
            # variables. This prevents integers becoming unicode values or
            # collection-like state being replaced with a scalar.
            if value == currentValue:
                return
            try:
                if name.startswith('persistent.'):
                    owner = renpy.game.persistent
                    path = name[11:]
                elif name.startswith('store.'):
                    owner = renpy.store
                    path = name[6:]
                else:
                    owner = renpy.store
                    path = name
                parts = path.split('.')
                for part in parts[:-1]:
                    owner = getattr(owner, part)
                setattr(owner, parts[-1], value)
            except:
                pass

        def confirmPendingJump(self):
            target = self._pendingJumpTarget
            if not target:
                return
            for item in self._pendingJumpVariables:
                self._setJumpVariable(item['name'], self._pendingJumpValues.get(item['name'], item['value']), self._pendingJumpOriginalValues.get(item['name']))
            self._pendingJumpTarget = None
            self._pendingJumpVariables = []
            self._pendingJumpValues = {}
            self._pendingJumpOriginalValues = {}
            renpy.hide_screen('URM_labeltree_jump_confirm')
            renpy.hide_screen('URM_labeltree_jump_value_menu')
            renpy.hide_screen('URM_main')
            renpy.jump(target)

        def _makeSearchFields(self, node):
            fields = {'labels': node['name'].lower(), 'variables': [], 'conditions': [], 'links': [], 'statements': []}
            for detail in node['details']:
                text = detail['text']
                kind = detail['kind']
                if kind in ('if', 'elif', 'else', 'while', 'menu'):
                    fields['conditions'].extend([text, detail.get('condition') or ''])
                if kind == 'variable':
                    fields['variables'].append(text)
                if kind == 'link':
                    fields['links'].extend([text, detail.get('target') or ''])
                fields['statements'].append(text)
            for key in fields:
                if key != 'labels':
                    fields[key] = ' '.join(fields[key]).lower()
            return fields

        def _searchCandidateNodes(self):
            """Return searchable label entries without requiring AST completion.

            Ren'Py exposes the complete label-name set before the incremental
            AST walk finishes. Use lightweight entries for labels not yet
            published into ``byName`` so label searches and previews work
            immediately; completed nodes transparently contribute their
            variables, conditions, links, and statements as they become
            available.
            """
            candidates = []
            for name in self._labelNames():
                node = self.byName.get(name)
                if node is None:
                    node = {
                        'name': name,
                        'displayName': self._wrapLabel(name),
                        'details': [],
                        'internal': name.startswith('_'),
                        'kind': 'Internal' if name.startswith('_') else 'Label',
                    }
                    node['_searchFields'] = self._makeSearchFields(node)
                candidates.append(node)
            return candidates

        def _matches(self, node, query, filters, showInternal):
            raw, terms = self._searchTerms(query)
            return self._searchMatchesTerms(node, terms, filters, showInternal)

        def _allSearchResults(self, query, labels=True, variables=True, conditions=True, links=True, statements=True, showInternal=False):
            # Search the complete label-name index immediately. AST-backed
            # fields are added as the background graph becomes available, so
            # the results pane is usable while the tree is still building.
            raw, terms = self._searchTerms(query)
            cacheKey = (raw, tuple(terms), bool(labels), bool(variables),
                        bool(conditions), bool(links), bool(statements),
                        bool(showInternal), self._buildRevision)
            if not raw:
                self._searchBuildKey = None
                self._searchBuilding = False
                self._searchAllResults = []
                self._searchCacheResults = []
                self._searchCacheKey = cacheKey
                return []
            if cacheKey == self._searchBuildKey:
                # The AST graph may still be publishing nodes in the
                # background. Continue the same search at the newly appended
                # node index instead of returning a prematurely complete
                # result set.
                if self._searchBuildIndex >= len(self._searchBuildNodes):
                    return self._searchAllResults
                self._searchBuilding = True
                return self._searchAllResults
            filters = {'labels': labels, 'variables': variables, 'conditions': conditions, 'links': links, 'statements': statements}
            self._startSearchBuild(cacheKey, raw, terms, filters, showInternal)
            return self._searchAllResults

        def searchResults(self, query, labels=True, variables=True, conditions=True, links=True, statements=True, showInternal=False):
            self._allSearchResults(query, labels, variables, conditions, links, statements, showInternal)
            return self._searchCacheResults

        def searchResultsAll(self, query, labels=True, variables=True, conditions=True, links=True, statements=True, showInternal=False):
            return self._allSearchResults(query, labels, variables, conditions, links, statements, showInternal)

        def searchResultCount(self, query, labels=True, variables=True, conditions=True, links=True, statements=True, showInternal=False):
            return len(self._allSearchResults(query, labels, variables, conditions, links, statements, showInternal))

        def navigateSearch(self, query, direction, labels=True, variables=True, conditions=True, links=True, statements=True, showInternal=False):
            results = self._allSearchResults(query, labels, variables, conditions, links, statements, showInternal)
            if not results:
                self.selectedLabel = None
                renpy.restart_interaction()
                return
            currentIndex = -1
            for index, node in enumerate(results):
                if node['name'] == self.selectedLabel:
                    currentIndex = index
                    break
            if direction < 0:
                nextIndex = len(results) - 1 if currentIndex <= 0 else currentIndex - 1
            else:
                nextIndex = 0 if currentIndex < 0 or currentIndex >= len(results) - 1 else currentIndex + 1
            self.focus(results[nextIndex]['name'])

        def isSearchMatch(self, node, query, labels=True, variables=True, conditions=True, links=True, statements=True, showInternal=False):
            query = (query or '').strip()
            if not query:
                return False
            filters = {'labels': labels, 'variables': variables, 'conditions': conditions, 'links': links, 'statements': statements}
            return self._matches(node, query, filters, showInternal)

        def visibleNodes(self, showInternal=False, query='', labels=True, variables=True, conditions=True, links=True, statements=True, showSearched=True, showCurrent=True):
            if not self._ready:
                return []
            focusedNames = self._focusedNames(query, labels, variables, conditions, links, statements, showInternal, showSearched, showCurrent)
            self._layoutFocus(focusedNames)
            self._applyPendingCenter()
            try:
                scale = float(scalePxInt(1))
            except:
                scale = 1.0
            if scale < 1.0:
                scale = 1.0
            zoom = self.zoom if self.zoom > 0 else 1.0
            try:
                left = self.xAdjustment.value / (scale * zoom) - 320
                top = self.yAdjustment.value / (scale * zoom) - 320
            except:
                left = -320
                top = -320
            right = left + (renpy.config.screen_width / (scale * zoom)) + 640
            bottom = top + (renpy.config.screen_height / (scale * zoom)) + 640
            visible = []
            for name in focusedNames:
                node = self.byName.get(name)
                if not node:
                    continue
                if node['internal'] and not showInternal and node['name'] != self.currentLabel():
                    continue
                nodeRight = node['x'] + node['width']
                nodeBottom = node['y'] + node['height']
                if nodeBottom >= top and node['y'] <= bottom and nodeRight >= left and node['x'] <= right:
                    visible.append(node)
            return visible

        def visibleEdges(self, nodes):
            names = set([node['name'] for node in nodes])
            edges = []
            seen = set()
            for name in names:
                for edge in self._edgesByNode.get(name, []):
                    if edge['source'] not in names or edge['target'] not in names:
                        continue
                    key = (edge['source'], edge['target'], edge['condition'], edge['kind'])
                    if key not in seen:
                        seen.add(key)
                        edges.append(edge)
            return edges

        def edgeGeometry(self, edge):
            source = self.byName.get(edge['source'])
            target = self.byName.get(edge['target'])
            if not source or not target:
                return None
            x1 = source['x'] + source['width'] / 2
            y1 = source['y'] + source['height']
            x2 = target['x'] + target['width'] / 2
            y2 = target['y']
            midY = (y1 + y2) / 2
            labelWidth = 170
            labelHeight = 36
            return {
                'x1': x1, 'y1': y1, 'x2': x2, 'y2': y2, 'midY': midY,
                'leftX': self._min2(x1, x2),
                'horizontalWidth': self._max2(x1, x2) - self._min2(x1, x2) + 2,
                'sourceLineHeight': midY - y1,
                'targetLineHeight': y2 - midY,
                'labelX': (x1 + x2) / 2 - labelWidth / 2,
                'labelY': midY - labelHeight / 2,
                'labelWidth': labelWidth,
                'labelHeight': labelHeight,
                'condition': edge['condition'],
                'kind': edge['kind'],
            }

    LabelTree = LabelTreeClass()


screen URM_labeltree_content():
    style_prefix 'x52URM'
    # Match the working URM search fields: keyboard builds start focused, while
    # touch builds wait for an explicit tap on the field.
    default searchInput = x52URM.Input(text=x52URM.LabelTree.savedSearchQuery(), autoFocus=not renpy.variant('touch'))
    default showInternal = x52URM.LabelTree.getFilter('showInternal', False)
    default filterLabels = x52URM.LabelTree.getFilter('filterLabels', True)
    default filterVariables = x52URM.LabelTree.getFilter('filterVariables', True)
    default filterConditions = x52URM.LabelTree.getFilter('filterConditions', True)
    default filterLinks = x52URM.LabelTree.getFilter('filterLinks', True)
    default filterStatements = x52URM.LabelTree.getFilter('filterStatements', True)
    default queryText = ''
    default allSearchResults = []
    default resultsPaneOpen = True
    default viewFilterOpen = False
    default showSearchedBranches = x52URM.LabelTree.getFilter('showSearchedBranches', False)
    default showCurrentBranch = x52URM.LabelTree.getFilter('showCurrentBranch', True)
    default confirmBranchJump = x52URM.LabelTree.getFilter('confirmBranchJump', True)

    python:
        x52URM.LabelTree.ensureBuilt(8)
        x52URM.LabelTree.centerCurrent()
        x52URM.LabelTree.noteViewportPosition()
        # InputValue is the Ren'Py contract for screen input. Read through
        # get_text() instead of relying on implementation-specific attributes.
        # This is a screen-local InputValue. Ren'Py's documented contract is
        # get_text()/set_text(); GetScreenInput is an action-time bridge for
        # callbacks and cannot resolve this local variable during screen
        # evaluation.
        try:
            queryText = searchInput.get_text()
        except:
            queryText = ''
        queryText = x52URM.LabelTree._safeText(queryText, '')
        x52URM.LabelTree.setSearchQuery(queryText)
        allSearchResults = x52URM.LabelTree.searchResultsAll(queryText, filterLabels, filterVariables, filterConditions, filterLinks, filterStatements, showInternal)
        searchMatchCount = len(allSearchResults)
        resultsPaneWidth = x52URM.scalePxInt(320)
        # The Label Tree is inside the main screen's 100px tab rail. Reserve
        # that rail before sizing the graph, otherwise the results pane is
        # placed beyond the right edge on scaled displays.
        treeContentWidth = x52URM.scalePxInt(renpy.config.screen_width - 100)
        graphViewportMaximum = x52URM.LabelTree._max2(x52URM.scalePxInt(320), treeContentWidth - resultsPaneWidth) if queryText and resultsPaneOpen else treeContentWidth
        visibleNodes = x52URM.LabelTree.visibleNodes(showInternal, queryText, filterLabels, filterVariables, filterConditions, filterLinks, filterStatements, showSearchedBranches, showCurrentBranch)
        visibleEdges = x52URM.LabelTree.visibleEdges(visibleNodes)

    key 'mousedown_4' action Function(x52URM.LabelTree.zoomIn)
    key 'mousedown_5' action Function(x52URM.LabelTree.zoomOut)
    if x52URM.LabelTree.needsBackgroundTick():
        # Keep AST construction, search indexing, and debounced persistence
        # off the input interaction. Small timer batches keep typing and
        # dragging responsive even when a game has thousands of labels.
        timer .03 repeat True action Function(x52URM.LabelTree.backgroundTick, 8, 64)

    on 'hide' action Function(x52URM.LabelTree.flushSearchPersistence)

    vbox:
        xfill True
        hbox:
            xfill True
            text 'Label Tree' style_suffix 'header_text' yalign .5
            null width x52URM.scalePxInt(12)
            hbox yalign .5:
                xfill True
                button:
                    xfill True
                    key_events True
                    sensitive not x52URM.LabelTree.isBuilding()
                    action searchInput.Enable()
                    input value searchInput
            textbutton '\ue880' style_suffix 'icon_button' action x52URM.LabelTree.clearFocus hovered x52URM.Tooltip('{urm_notl}Clear search focus{/urm_notl}') unhovered x52URM.Tooltip()
        hbox:
            spacing x52URM.scalePxInt(4)
            text 'Search in:' yalign .5 style_suffix 'description'
            use x52URM_checkbox(filterLabels, '{urm_notl}Labels{/urm_notl}', [SetLocalVariable('filterLabels', not filterLabels), Function(x52URM.LabelTree.setFilter, 'filterLabels', not filterLabels)])
            use x52URM_checkbox(filterVariables, '{urm_notl}Variables{/urm_notl}', [SetLocalVariable('filterVariables', not filterVariables), Function(x52URM.LabelTree.setFilter, 'filterVariables', not filterVariables)])
            use x52URM_checkbox(filterConditions, '{urm_notl}Conditions{/urm_notl}', [SetLocalVariable('filterConditions', not filterConditions), Function(x52URM.LabelTree.setFilter, 'filterConditions', not filterConditions)])
            use x52URM_checkbox(filterLinks, '{urm_notl}Links{/urm_notl}', [SetLocalVariable('filterLinks', not filterLinks), Function(x52URM.LabelTree.setFilter, 'filterLinks', not filterLinks)])
            use x52URM_checkbox(filterStatements, '{urm_notl}Statements{/urm_notl}', [SetLocalVariable('filterStatements', not filterStatements), Function(x52URM.LabelTree.setFilter, 'filterStatements', not filterStatements)])
            use x52URM_checkbox(showInternal, '{urm_notl}Internal{/urm_notl}', [SetLocalVariable('showInternal', not showInternal), Function(x52URM.LabelTree.setFilter, 'showInternal', not showInternal)])
            null width x52URM.scalePxInt(8)
            textbutton '{urm_notl}Current{/urm_notl}' style_suffix 'buttonSecondary' action Function(x52URM.LabelTree.centerCurrentNow) hovered x52URM.Tooltip('{urm_notl}Center current label{/urm_notl}') unhovered x52URM.Tooltip()
            textbutton '{urm_notl}Selected{/urm_notl}' style_suffix 'buttonSecondary' action Function(x52URM.LabelTree.centerSelected) hovered x52URM.Tooltip('{urm_notl}Center selected node{/urm_notl}') unhovered x52URM.Tooltip()
            textbutton x52URM.LabelTree.depthText() style_suffix 'buttonSecondary' action Show('URM_labeltree_depth_menu') hovered x52URM.Tooltip('{urm_notl}Choose current-branch depth{/urm_notl}') unhovered x52URM.Tooltip()
            textbutton x52URM.LabelTree.zoomPercentText() style_suffix 'icon_button' action Function(x52URM.LabelTree.zoomReset) hovered x52URM.Tooltip('{urm_notl}Reset zoom{/urm_notl}') unhovered x52URM.Tooltip()
            textbutton '\ue5d5' style_suffix 'icon_button' action Function(x52URM.LabelTree.refresh) hovered x52URM.Tooltip('{urm_notl}Refresh tree{/urm_notl}') unhovered x52URM.Tooltip()
        null height x52URM.scalePxInt(6)
        frame style_suffix 'seperator' ysize x52URM.scalePxInt(2)
        hbox:
            xfill True
            yfill True
            fixed:
                xsize graphViewportMaximum
                xminimum graphViewportMaximum
                xmaximum graphViewportMaximum
                yfill True
                viewport:
                    xfill True
                    xminimum x52URM.scalePxInt(1)
                    xmaximum graphViewportMaximum
                    yfill True
                    mousewheel True
                    draggable True
                    scrollbars 'both'
                    xadjustment x52URM.LabelTree.xAdjustment
                    yadjustment x52URM.LabelTree.yAdjustment
                    fixed:
                        xsize x52URM.scalePxInt(x52URM.LabelTree.graphWidth * x52URM.LabelTree.zoom)
                        ysize x52URM.scalePxInt(x52URM.LabelTree.graphHeight * x52URM.LabelTree.zoom)
                        at Transform(zoom=x52URM.LabelTree.zoom)
                        if x52URM.LabelTree.isBuilding():
                            text 'Building Label Tree... {}%'.format(x52URM.LabelTree.buildProgress()) xalign .5 yalign .5 style_suffix 'description'
                        elif not visibleNodes:
                            text 'Enable a view-filter branch or select a search result.' xalign .5 yalign .5 style_suffix 'description'
                        for edge in visibleEdges:
                            $ geometry = x52URM.LabelTree.edgeGeometry(edge)
                            if geometry:
                                $ pathEdge = x52URM.LabelTree.isSelectedPathEdge(edge)
                                $ edgeColor = x52URM.Theme.colors.buttonPrimaryBg if pathEdge else x52URM.Theme.colors.buttonSecondaryBg
                                $ lineWidth = 6 if pathEdge else 4
                                add Solid(edgeColor) xpos x52URM.scalePxInt(geometry['x1'] - lineWidth / 2) ypos x52URM.scalePxInt(geometry['y1']) xsize x52URM.scalePxInt(lineWidth) ysize x52URM.scalePxInt(geometry['sourceLineHeight'])
                                add Solid(edgeColor) xpos x52URM.scalePxInt(geometry['leftX']) ypos x52URM.scalePxInt(geometry['midY'] - lineWidth / 2) xsize x52URM.scalePxInt(geometry['horizontalWidth']) ysize x52URM.scalePxInt(lineWidth)
                                add Solid(edgeColor) xpos x52URM.scalePxInt(geometry['x2'] - lineWidth / 2) ypos x52URM.scalePxInt(geometry['midY']) xsize x52URM.scalePxInt(lineWidth) ysize x52URM.scalePxInt(geometry['targetLineHeight'])
                                frame xpos x52URM.scalePxInt(geometry['labelX']) ypos x52URM.scalePxInt(geometry['labelY']) xsize x52URM.scalePxInt(geometry['labelWidth']) ysize x52URM.scalePxInt(geometry['labelHeight']) background edgeColor:
                                    text geometry['condition'] size x52URM.scalePxInt(11) xalign .5 yalign .5 substitute False
                        for node in visibleNodes:
                            if showInternal or not node['internal'] or node['name'] == x52URM.LabelTree.currentLabel():
                                fixed:
                                    xpos x52URM.scalePxInt(node['x']) ypos x52URM.scalePxInt(node['y'])
                                    xsize x52URM.scalePxInt(node['width']) ysize x52URM.scalePxInt(node['height'])
                                    button:
                                        xfill True yfill True
                                        background x52URM.Theme.colors.buttonBg
                                        hover_background x52URM.Theme.colors.buttonSecondaryBgHover
                                        hovered x52URM.Tooltip(node['name'])
                                        unhovered x52URM.Tooltip()
                                        action Function(x52URM.LabelTree.nodeClicked, node['name'])
                                        hbox:
                                            xfill True
                                            yalign .5
                                            text node['displayName'] substitute False xmaximum x52URM.scalePxInt(node['width'] - 82) text_align 0.0 yalign .5 size x52URM.scalePxInt(14)
                                            null width x52URM.scalePxInt(8)
                                            text node['kind'] style_suffix 'description' xalign 1.0 yalign .5 size x52URM.scalePxInt(10)
                                    if node['name'] == x52URM.LabelTree.currentLabel():
                                        add Solid(x52URM.Theme.colors.buttonSuccessBg) xpos 0 ypos 0 xsize x52URM.scalePxInt(node['width']) ysize x52URM.scalePxInt(5)
                                    if node['name'] == x52URM.LabelTree.selectedLabel:
                                        add Solid(x52URM.Theme.colors.buttonSecondaryBgHover) xpos 0 ypos x52URM.scalePxInt(5) xsize x52URM.scalePxInt(node['width']) ysize x52URM.scalePxInt(5)
                                    if x52URM.LabelTree.isSearchMatch(node, queryText, filterLabels, filterVariables, filterConditions, filterLinks, filterStatements, showInternal):
                                        add Solid(x52URM.Theme.colors.buttonPrimaryBg) xpos 0 ypos x52URM.scalePxInt(10) xsize x52URM.scalePxInt(node['width']) ysize x52URM.scalePxInt(5)
                                    textbutton If(node['name'] in x52URM.LabelTree.expanded, '\ue5ce', '\ue5cf') style_suffix 'icon_button' xpos x52URM.scalePxInt(node['width'] - 34) ypos 0 action Function(x52URM.LabelTree.toggleExpanded, node['name'])
                                    if node['name'] in x52URM.LabelTree.expanded:
                                        frame ypos x52URM.scalePxInt(node['height'] + 4) xsize x52URM.scalePxInt(node['width']) ysize x52URM.scalePxInt(150) background x52URM.Theme.colors.buttonBg:
                                            viewport:
                                                mousewheel True
                                                draggable True
                                                scrollbars 'vertical'
                                                vbox:
                                                    for detail in node['details']:
                                                        text '{}: {}'.format(detail['kind'], detail['text']) size x52URM.scalePxInt(11) substitute False
                vbox:
                    xalign 1.0
                    yalign 0.0
                    spacing x52URM.scalePxInt(4)
                    textbutton '{urm_notl}View Filter{/urm_notl}' style_suffix 'buttonSecondary' action SetLocalVariable('viewFilterOpen', not viewFilterOpen)
                    if viewFilterOpen:
                        frame:
                            xsize x52URM.scalePxInt(250)
                            background x52URM.Theme.colors.buttonBg
                            vbox:
                                xfill True
                                text '{urm_notl}Show branches{/urm_notl}' style_suffix 'description'
                                use x52URM_checkbox(showSearchedBranches, '{urm_notl}Searched branches{/urm_notl}', [SetLocalVariable('showSearchedBranches', not showSearchedBranches), Function(x52URM.LabelTree.setFilter, 'showSearchedBranches', not showSearchedBranches)])
                                use x52URM_checkbox(showCurrentBranch, '{urm_notl}Current branch{/urm_notl}', [SetLocalVariable('showCurrentBranch', not showCurrentBranch), Function(x52URM.LabelTree.setFilter, 'showCurrentBranch', not showCurrentBranch)])
                                use x52URM_checkbox(confirmBranchJump, '{urm_notl}Confirm branch values before jump{/urm_notl}', [SetLocalVariable('confirmBranchJump', not confirmBranchJump), Function(x52URM.LabelTree.setFilter, 'confirmBranchJump', not confirmBranchJump)])
            if queryText and resultsPaneOpen:
                frame:
                    xsize resultsPaneWidth
                    yfill True
                    background x52URM.Theme.colors.buttonBg
                    vbox:
                        xfill True
                        yfill True
                        hbox:
                            xfill True
                            text 'Matches: {}'.format(searchMatchCount) style_suffix 'description' yalign .5
                            if x52URM.LabelTree.isSearchBuilding():
                                text '{urm_notl}(searching...){/urm_notl}' style_suffix 'description' yalign .5
                            null width x52URM.scalePxInt(8)
                            textbutton '{urm_notl}Previous{/urm_notl}' style_suffix 'buttonSecondary' action Function(x52URM.LabelTree.navigateSearch, queryText, -1, filterLabels, filterVariables, filterConditions, filterLinks, filterStatements, showInternal)
                            textbutton '{urm_notl}Next{/urm_notl}' style_suffix 'buttonSecondary' action Function(x52URM.LabelTree.navigateSearch, queryText, 1, filterLabels, filterVariables, filterConditions, filterLinks, filterStatements, showInternal)
                            textbutton '\ue5c9' style_suffix 'icon_button' action SetLocalVariable('resultsPaneOpen', False) hovered x52URM.Tooltip('{urm_notl}Collapse results pane{/urm_notl}') unhovered x52URM.Tooltip()
                        viewport:
                            xfill True
                            yfill True
                            mousewheel True
                            draggable True
                            scrollbars 'vertical'
                            vbox:
                                for result in allSearchResults:
                                    button:
                                        xfill True
                                        ysize x52URM.scalePxInt(86)
                                        action Function(x52URM.LabelTree.focus, result['name'])
                                        selected result['name'] == x52URM.LabelTree.selectedLabel
                                        vbox:
                                            xfill True
                                            yalign .5
                                            text x52URM.LabelTree.previewName(result['name']) substitute False xmaximum x52URM.scalePxInt(260) text_align 0.0 size x52URM.scalePxInt(13)
                                            if result['details']:
                                                text '({} details)'.format(len(result['details'])) style_suffix 'description'
            elif queryText:
                frame:
                    xsize x52URM.scalePxInt(38)
                    yfill True
                    background x52URM.Theme.colors.buttonBg
                    textbutton '\ue5c9' style_suffix 'icon_button' action SetLocalVariable('resultsPaneOpen', True) hovered x52URM.Tooltip('{urm_notl}Expand results pane{/urm_notl}') unhovered x52URM.Tooltip()


screen URM_labeltree_jump_confirm():
    layer 'x52Overlay'
    modal True
    zorder 1100
    style_prefix 'x52URM'
    frame:
        xalign .5
        yalign .5
        xmaximum x52URM.scalePxInt(620)
        background x52URM.Theme.colors.buttonBg
        padding (x52URM.scalePxInt(16), x52URM.scalePxInt(12))
        vbox:
            spacing x52URM.scalePxInt(6)
            text 'Confirm branch variables' style_suffix 'header_text'
            text 'Choose values for conditional variables before jumping to:' style_suffix 'description'
            text x52URM.LabelTree._pendingJumpTarget substitute False
            if not x52URM.LabelTree.pendingJumpVariables():
                text 'No editable scalar variables were detected. Click Done to continue, or Cancel to stay here.' style_suffix 'description'
            viewport:
                ymaximum x52URM.scalePxInt(360)
                mousewheel True
                draggable True
                scrollbars 'vertical'
                vbox:
                    spacing x52URM.scalePxInt(3)
                    for item in x52URM.LabelTree.pendingJumpVariables():
                        hbox:
                            xfill True
                            text item['name'] substitute False xmaximum x52URM.scalePxInt(310)
                            null width x52URM.scalePxInt(8)
                            textbutton x52URM.LabelTree.pendingJumpValue(item['name']) substitute False style_suffix 'buttonSecondary' action Show('URM_labeltree_jump_value_menu', variable=item['name'])
            hbox:
                xalign .5
                spacing x52URM.scalePxInt(8)
                textbutton 'Cancel' style_suffix 'buttonSecondary' action Function(x52URM.LabelTree.cancelPendingJump)
                textbutton 'Done' style_suffix 'buttonPrimary' action Function(x52URM.LabelTree.confirmPendingJump)


screen URM_labeltree_jump_value_menu(variable):
    layer 'x52Overlay'
    modal True
    zorder 1200
    style_prefix 'x52URM'
    frame:
        xalign .5
        yalign .5
        background x52URM.Theme.colors.buttonBg
        padding (x52URM.scalePxInt(12), x52URM.scalePxInt(10))
        vbox:
            spacing x52URM.scalePxInt(3)
            text variable substitute False style_suffix 'header_text'
            for item in x52URM.LabelTree.pendingJumpVariables():
                if item['name'] == variable:
                    for option in item['options']:
                        textbutton option substitute False xfill True style_suffix 'buttonSecondary' action [Function(x52URM.LabelTree.setPendingJumpValue, variable, option), Hide('URM_labeltree_jump_value_menu')]
            textbutton 'Cancel' style_suffix 'buttonSecondary' xfill True action Hide('URM_labeltree_jump_value_menu')
